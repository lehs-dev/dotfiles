// VS Code — tập trung vào trải nghiệm viết và đọc code.
{
    "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
    "editor.fontWeight": "600",
    "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
    "terminal.integrated.fontWeight": "550",
    "editor.fontLigatures": true,
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.acceptSuggestionOnEnter": "smart",
    "files.autoSave": "afterDelay",
    "editor.formatOnSave": false,
    "workbench.editor.enablePreview": false,
    "window.autoDetectColorScheme": true,
    "workbench.experimental.modernUI": true,
    "workbench.preferredDarkColorTheme": "Dark 2026",
    "workbench.colorCustomizations": {
        // Máy sáng: vùng làm việc sáng, nền ngoài tối.
        "[Light 2026]": {
            "modernUI.shellBackground": "#3D4046",
            "modernUI.inactiveShellBackground": "#3D4046",
            "modernSash.gripForeground": "#C7CBD1",
            "titleBar.activeBackground": "#3D4046",
            "titleBar.inactiveBackground": "#3D4046",
            "titleBar.activeForeground": "#F3F4F6",
            "titleBar.inactiveForeground": "#C7CBD1",
            "commandCenter.foreground": "#F3F4F6",
            "commandCenter.activeForeground": "#F3F4F6",
            "commandCenter.inactiveForeground": "#C7CBD1",
            "statusBar.background": "#3D4046",
            "statusBar.noFolderBackground": "#3D4046",
            "statusBar.inactiveBackground": "#3D4046",
            "statusBar.foreground": "#F3F4F6",
            "statusBar.noFolderForeground": "#F3F4F6",
            // ===== GENERAL TEXT: darker / clearer =====
            "foreground": "#20242A",
            "descriptionForeground": "#4A515A",
            "icon.foreground": "#30363D",
            "sideBar.foreground": "#24292F",
            "sideBarTitle.foreground": "#111418",
            "sideBarSectionHeader.foreground": "#24292F",
            "activityBar.foreground": "#20242A",
            "activityBar.inactiveForeground": "#505861",
            "modernActivityBarItem.activeForeground": "#111418",
            "modernActivityBarItem.hoverForeground": "#000000",
            "list.activeSelectionForeground": "#111418",
            "list.inactiveSelectionForeground": "#24292F",
            "list.hoverForeground": "#000000",
            "breadcrumb.foreground": "#30363D",
            "breadcrumb.focusForeground": "#000000",
            "tab.activeForeground": "#111418",
            "tab.inactiveForeground": "#3D444D",
            "modernEditorTab.activeForeground": "#111418",
            "modernEditorTab.hoverForeground": "#000000",
            // ===== GIT: mỗi trạng thái một họ màu riêng =====
            "gitDecoration.untrackedResourceForeground": "#0969DA", // U = blue
            "gitDecoration.modifiedResourceForeground": "#B65C00", // M = orange
            "gitDecoration.addedResourceForeground": "#1A7F37", // A = green
            "gitDecoration.deletedResourceForeground": "#CF222E", // D = red
            "gitDecoration.renamedResourceForeground": "#8250DF", // R = purple
            "gitDecoration.conflictingResourceForeground": "#B42318",
            "gitDecoration.ignoredResourceForeground": "#6E7781",
            // ===== WARNINGS / ERRORS =====
            "list.warningForeground": "#C25D00",
            "list.errorForeground": "#CF222E",
            "editorWarning.foreground": "#D97706",
            "editorError.foreground": "#D1242F",
            "problemsWarningIcon.foreground": "#D97706",
            "problemsErrorIcon.foreground": "#D1242F",
            // Activity badges nếu có warning/error thật sự
            "activityWarningBadge.background": "#D97706",
            "activityWarningBadge.foreground": "#FFFFFF",
            "activityErrorBadge.background": "#D1242F",
            "activityErrorBadge.foreground": "#FFFFFF"
        },
        // Máy tối: vùng làm việc tối, nền ngoài sáng.
        "[Dark 2026]": {
            "modernUI.shellBackground": "#D8DBE0",
            "modernUI.inactiveShellBackground": "#D8DBE0",
            "modernSash.gripForeground": "#5B6068",
            "titleBar.activeBackground": "#D8DBE0",
            "titleBar.inactiveBackground": "#D8DBE0",
            "titleBar.activeForeground": "#25282E",
            "titleBar.inactiveForeground": "#5B6068",
            "commandCenter.foreground": "#25282E",
            "commandCenter.activeForeground": "#25282E",
            "commandCenter.inactiveForeground": "#5B6068",
            "statusBar.background": "#D8DBE0",
            "statusBar.noFolderBackground": "#D8DBE0",
            "statusBar.inactiveBackground": "#D8DBE0",
            "statusBar.foreground": "#25282E",
            "statusBar.noFolderForeground": "#25282E",
            // ===== GENERAL TEXT: brighter / clearer =====
            "foreground": "#ECEFF3",
            "descriptionForeground": "#C5CBD3",
            "icon.foreground": "#D8DCE2",
            "sideBar.foreground": "#E5E8EC",
            "sideBarTitle.foreground": "#F5F6F8",
            "sideBarSectionHeader.foreground": "#E5E8EC",
            "activityBar.foreground": "#ECEFF3",
            "activityBar.inactiveForeground": "#BCC3CC",
            "modernActivityBarItem.activeForeground": "#FFFFFF",
            "modernActivityBarItem.hoverForeground": "#FFFFFF",
            "list.activeSelectionForeground": "#FFFFFF",
            "list.inactiveSelectionForeground": "#E2E5E9",
            "list.hoverForeground": "#FFFFFF",
            "breadcrumb.foreground": "#D6DAE0",
            "breadcrumb.focusForeground": "#FFFFFF",
            "tab.activeForeground": "#FFFFFF",
            "tab.inactiveForeground": "#C7CDD5",
            "modernEditorTab.activeForeground": "#FFFFFF",
            "modernEditorTab.hoverForeground": "#FFFFFF",
            // ===== GIT =====
            "gitDecoration.untrackedResourceForeground": "#58A6FF",
            "gitDecoration.modifiedResourceForeground": "#FFA657",
            "gitDecoration.addedResourceForeground": "#56D364",
            "gitDecoration.deletedResourceForeground": "#FF7B72",
            "gitDecoration.renamedResourceForeground": "#D2A8FF",
            "gitDecoration.conflictingResourceForeground": "#FF7B72",
            "gitDecoration.ignoredResourceForeground": "#8B949E",
            // ===== WARNINGS / ERRORS =====
            "list.warningForeground": "#E3A008",
            "list.errorForeground": "#FF6B6B",
            "editorWarning.foreground": "#E3A008",
            "editorError.foreground": "#FF6B6B",
            "problemsWarningIcon.foreground": "#F0B429",
            "problemsErrorIcon.foreground": "#FF6B6B",
            "activityWarningBadge.background": "#D99A00",
            "activityWarningBadge.foreground": "#151515",
            "activityErrorBadge.background": "#D94A4A",
            "activityErrorBadge.foreground": "#FFFFFF"
        }
    },
    "telemetry.telemetryLevel": "off",
    "workbench.experimental.modernUIEditorTabStyle": "pill",
    "window.zoomLevel": 1,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "workbench.iconTheme": "symbols",
    "terminal.integrated.cursorStyle": "underline",
    "workbench.startupEditor": "none",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.editor.tabSizing": "fit",
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.md": "vscode.markdown.preview.editor"
    },
    "chatgpt.followUpQueueMode": "steer",
    "terminal.integrated.fontSize": 12,
    "workbench.panel.showLabels": false,
    "remote.autoForwardPortsSource": "hybrid"
}